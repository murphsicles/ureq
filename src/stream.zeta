 }
 
}

fn time_until_deadline(deadline: Instant) -> io::Result<Duration> {
 let now = Instant::now();
 match deadline.checked_duration_since(now) { None => Err(io_err_timeout("timed out reading response" . to_string())), Some(duration) => Ok(duration) }
}

fn io_err_timeout(error: String) -> io::Error {
